{
  "expo": {
    "name": "VunaPOS",
    "slug": "vunapos-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/vunapos-logo.png",
    "scheme": "vunapos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/vunapos-logo.png"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.vunaposmobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/vunapos-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f8f8f8",
          "image": "./assets/images/vunapos-splash.png",
          "imageWidth": 96,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
